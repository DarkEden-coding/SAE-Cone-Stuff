# Cone app runtime data (uploaded media, jobs, results, intrinsics profiles)
cone_app_data/

# Cone app mock results are generated by cone_app/static/dev/gen_mock.js
cone_app/static/dev/mock_result_*.json

# Xcode (the project is generated by XcodeGen from cone_app/ios/ConeCapture/project.yml)
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
build/
