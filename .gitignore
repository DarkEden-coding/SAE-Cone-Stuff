# Model weights and training runs. Only the checkpoint the cone app serves is tracked.
*.pt
*.onnx
*.engine
runs/*
!runs/by-n-E-far/
runs/by-n-E-far/*
!runs/by-n-E-far/weights/
runs/by-n-E-far/weights/*
